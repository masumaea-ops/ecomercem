# Dependencies
node_modules/
server/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Local SQLite & Binary Databases (Existing DB used in production)
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
database.sqlite

# Production Builds & Bundles
dist/
dist-ssr/
server/dist/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Prompt / AI Transcripts & Local Brain Artifacts
migrated_prompt_history/
scratch/
.system_generated/

# Uploaded Media & Temporary Runtime Files
server/uploads/*
!server/uploads/.gitkeep
tmp/
temp/

# Editor & OS Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
