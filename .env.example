# ==========================================
# MASUMA E-COMMERCE & ERP ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in values for your environment.
# ==========================================

# ------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# ------------------------------------------
# Database Configuration (Existing MySQL)
# ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=masuma_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=masuma_db

# Set DB_SYNC=false for production to protect existing database tables
DB_SYNC=false

# Optional fallback: set DB_TYPE=sqlite if running in isolated local mode
# DB_TYPE=mysql

# ------------------------------------------
# Security & Authentication
# ------------------------------------------
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# Optional Initial Admin Seeding Configuration
ADMIN_EMAIL=admin@masuma.africa
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongInitialPassword123!

# ------------------------------------------
# Redis Configuration (Optional / Caching & BullMQ)
# ------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# Daraja M-Pesa Integration (Safaricom)
# ------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_STORE_NUMBER=

# ------------------------------------------
# Email & SMTP Settings
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@masuma.africa

# ------------------------------------------
# Third-Party External APIs
# ------------------------------------------
GEMINI_API_KEY=
VIN_API_KEY=
EXCHANGE_RATE_API_KEY=

# ------------------------------------------
# KRA eTIMS Integration
# ------------------------------------------
KRA_PIN=
DEVICE_SERIAL=
KRA_API_URL=https://etims-api.kra.go.ke

# ------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------
VITE_API_URL=https://yourdomain.com/api
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
